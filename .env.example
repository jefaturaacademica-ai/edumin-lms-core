NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Si tu proyecto usa la clave anónima tradicional, usa esta variable en vez de
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# URL externa del beneficio Dreambuilder para paquetes FULL e ILIMITADO.
NEXT_PUBLIC_DREAMBUILDER_URL=https://dreambuilder.com
# Endpoint de automatización para pagos registrados por tesorería.
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/pago-registrado
# Endpoint para automatizaciones de nuevas matrículas.
NEXT_PUBLIC_N8N_Q10_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/curso-matriculado
